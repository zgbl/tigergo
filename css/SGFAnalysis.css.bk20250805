/* SGF 分析页面专用样式 - 修复导航条并优化布局 */

/* 确保导航条正常显示 */
#navbar-placeholder {
    width: 100%;
    z-index: 1000;
}

.analysis-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 15px;
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 20px;
}

.main-content {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 20px;
}

.sidebar {
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 20px;
    height: fit-content;
}

.page-header {
    text-align: center;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #e0e0e0;
}

.page-title {
    font-size: 1.8em;
    color: #2c3e50;
    margin-bottom: 5px;
    font-weight: 600;
}

.page-subtitle {
    font-size: 0.9em;
    color: #7f8c8d;
    margin: 0;
}

/* 上传区域和棋盘区域左右并列布局 */
.upload-board-container {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 15px;
    margin-bottom: 15px;
}

/* 紧凑的上传区域 */
.upload-section {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 6px;
    padding: 15px;
    color: white;
    height: fit-content;
}

.upload-title {
    font-size: 0.95em;
    margin-bottom: 10px;
    font-weight: 600;
    text-align: center;
}

/* 紧凑的拖拽区域 */
.upload-area {
    border: 2px dashed rgba(255,255,255,0.5);
    border-radius: 6px;
    padding: 12px;
    margin: 8px 0;
    transition: all 0.3s ease;
    cursor: pointer;
    background: rgba(255,255,255,0.1);
    text-align: center;
    min-height: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.upload-area:hover {
    border-color: rgba(255,255,255,0.8);
    background: rgba(255,255,255,0.2);
}

.upload-area.dragover {
    border-color: #fff;
    background: rgba(255,255,255,0.3);
}

.upload-icon {
    font-size: 1.2em;
    margin-bottom: 4px;
    opacity: 0.8;
}

.upload-text {
    font-size: 0.8em;
    margin-bottom: 2px;
}

.upload-hint {
    font-size: 0.7em;
    opacity: 0.8;
    margin-bottom: 6px;
}

.file-input {
    display: none;
}

.upload-buttons {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin-top: 8px;
}

.upload-btn, .analyze-file-btn {
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.5);
    color: white;
    padding: 6px 12px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 0.8em;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
}

.upload-btn:hover, .analyze-file-btn:hover {
    background: rgba(255,255,255,0.3);
    border-color: rgba(255,255,255,0.8);
}

.analyze-file-btn:disabled {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.3);
    cursor: not-allowed;
    opacity: 0.6;
}

/* 紧凑的文件信息显示 */
.file-info {
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 4px;
    padding: 6px 10px;
    margin: 8px 0 0 0;
    display: none;
    font-size: 0.8em;
}

.file-info.show {
    display: block;
}

.file-name {
    font-weight: 600;
    color: white;
    margin: 0 0 2px 0;
    font-size: 0.85em;
}

.file-details {
    font-size: 0.7em;
    color: rgba(255,255,255,0.8);
}

/* 棋盘区域 */
.board-container {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 15px;
    text-align: center;
}

.board-placeholder {
    width: 100%;
    height: 200px;
    background: linear-gradient(45deg, #DEB887, #D2B48C);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8B4513;
    font-size: 0.9em;
    border: 2px solid #CD853F;
    flex-direction: column;
}

.analysis-controls {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-top: 8px;
    min-height: 300px;
    flex-wrap: wrap;
}

.control-btn {
    background: #3498db;
    color: white;
    border: none;
    padding: 4px 8px;
    border-radius: 3px;
    cursor: pointer;
    font-size: 0.75em;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 2px;
}

.control-btn:hover {
    background: #2980b9;
    transform: translateY(-1px);
}

.control-btn:disabled {
    background: #bdc3c7;
    cursor: not-allowed;
    transform: none;
}

/* 分析结果区域 */
.analysis-results-section {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 150px 15px;
    min-height: 250px;
    margin-top: 15px;
}

.section-title {
    font-size: 1.1em;
    color: #2c3e50;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
}

/* 紧凑的侧边栏 */
.analysis-panel {
    margin-bottom: 15px;
}

.panel-title {
    font-size: 1em;
    color: #2c3e50;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
}

.connection-status {
    padding: 8px;
    border-radius: 4px;
    font-size: 0.85em;
    text-align: center;
    margin-bottom: 12px;
}

.connection-status.connecting {
    background: #fff3cd;
    color: #856404;
    border: 1px solid #ffeaa7;
}

.connection-status.connected {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}

.connection-status.error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
}

.settings-panel {
    margin-bottom: 12px;
}

.setting-group {
    margin-bottom: 10px;
}

.setting-label {
    display: block;
    font-size: 0.85em;
    color: #495057;
    margin-bottom: 4px;
    font-weight: 500;
}

.setting-select, .setting-input {
    width: 100%;
    padding: 6px;
    border: 1px solid #ced4da;
    border-radius: 3px;
    font-size: 0.85em;
    background: white;
}

.analyze-btn {
    width: 100%;
    background: #28a745;
    color: white;
    border: none;
    padding: 10px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 0.9em;
    font-weight: 600;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.analyze-btn:hover:not(:disabled) {
    background: #218838;
    transform: translateY(-1px);
}

.analyze-btn:disabled {
    background: #6c757d;
    cursor: not-allowed;
    transform: none;
}

.analysis-status {
    font-size: 0.85em;
}

.status-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    padding: 3px 0;
}

.status-label {
    color: #6c757d;
    font-weight: 500;
}

.status-value {
    color: #495057;
    font-weight: 600;
}

.progress-bar {
    width: 100%;
    height: 6px;
    background: #e9ecef;
    border-radius: 3px;
    overflow: hidden;
    margin-top: 8px;
}

.progress-fill {
    height: 100%;
    background: #28a745;
    width: 0%;
    transition: width 0.3s ease;
}

/* 扩大分析结果和日志显示区域 */
.analysis-results, .analysis-log {
    max-height: 350px;
    overflow-y: auto;
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    padding: 12px;
    min-height: 259px;
    font-size: 0.85em;
    margin-bottom: 10px;
}

.log-entry {
    margin-bottom: 3px;
    padding: 2px 0;
    font-family: 'Courier New', monospace;
    line-height: 1.3;
}

.log-entry.success {
    color: #28a745;
}

.log-entry.error {
    color: #dc3545;
}

.log-entry.warning {
    color: #ffc107;
}

.log-entry.info {
    color: #17a2b8;
}

/* 结果条目样式 */
.result-entry {
    margin-bottom: 10px;
    padding: 8px;
    background: #f8f9fa;
    border-radius: 4px;
    font-size: 0.85em;
    border-left: 4px solid #28a745;
}

/* 响应式设计 */
@media (max-width: 1200px) {
    .analysis-container {
        grid-template-columns: 1fr;
        gap: 15px;
    }
    
    .sidebar {
        order: -1;
    }
    
    .upload-board-container {
        grid-template-columns: 1fr;
        gap: 10px;
    }
    
    .upload-section {
        padding: 12px;
        width: 100px;
    }
    
    .upload-area {
        min-height: 45px;
        padding: 10px;
    }
    
    .board-placeholder {
        height: 150px;
    }
}

@media (max-width: 768px) {
    .upload-board-container {
        grid-template-columns: 1fr;
    }
    
    .upload-buttons {
        flex-direction: column;
        gap: 4px;
    }
    
    .upload-btn, .analyze-file-btn {
        width: 100%;
        justify-content: center;
    }
}

/* 确保主要内容区域有足够空间 */
.main-content {
    min-height: 600px;
}

/* 优化分析面板布局 */
.analysis-panel:last-child {
    margin-bottom: 0;
}

/* 分析结果区域优化 */
.analysis-results {
    border-left: 4px solid #28a745;
}

.analysis-log {
    border-left: 4px solid #17a2b8;
}

/* 新增：内容网格布局 */
.content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
}

.analysis-results-section {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 15px;
}

.section-title {
    font-size: 1.1em;
    color: #2c3e50;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
}